# One style for the project's own C and C++ (src/{driver,frontend,optimizer,backend}, include/; lib/ and the MSL and
# runtime wrappers are .clang-format-ignore's): `.venv/bin/clang-format -i FILE...` (pyproject.toml pins the version).
#
# Rust-flavoured, roughly rustfmt's defaults: 4-space indent, 100 columns, braces attached, block-indented (not
# visually aligned) continuations, one item per line once a list doesn't fit, no column alignment.
#
# Matching constraints: MWCC's code can follow the source's shape, so nothing here changes what the compiler sees
# beyond braces (InsertBraces: check a reformat with tools/verify.py). Includes keep their order (a #define can come
# before the header that reads it), comments are not reflowed, string literals are not split, and no parenthesis or
# semicolon is added or removed.
---
BasedOnStyle: LLVM
Standard: Latest

# --- Layout ---------------------------------------------------------------
ColumnLimit: 100
IndentWidth: 4
TabWidth: 4
UseTab: Never
ContinuationIndentWidth: 4
IndentCaseLabels: true
IndentCaseBlocks: false
IndentGotoLabels: false
IndentPPDirectives: None
IndentExternBlock: NoIndent
IndentWrappedFunctionNames: false
MaxEmptyLinesToKeep: 1
KeepEmptyLines:
  AtStartOfBlock: false
  AtStartOfFile: false
  AtEndOfFile: false
InsertNewlineAtEOF: true
LineEnding: LF

# --- Braces: always, on the same line --------------------------------------
BreakBeforeBraces: Attach
InsertBraces: true

# --- Short things ----------------------------------------------------------
AllowShortFunctionsOnASingleLine: Empty
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortBlocksOnASingleLine: Empty
AllowShortCaseLabelsOnASingleLine: false
AllowShortEnumsOnASingleLine: false

# --- Breaking / wrapping (rustfmt-style block indent) ---------------------
AlignAfterOpenBracket: BlockIndent
# (an if's condition breaks like any expression: no lone `) {`, the same for `if` and `else if`)
BreakAfterOpenBracketIf: false
BreakBeforeCloseBracketIf: false
AlignOperands: DontAlign
AlignTrailingComments:
  Kind: Never
AlignConsecutiveAssignments: None
AlignConsecutiveDeclarations: None
AlignConsecutiveMacros: None
AlignConsecutiveBitFields: None
AlignEscapedNewlines: DontAlign
AlignArrayOfStructures: None
BinPackArguments: false
BinPackParameters: OnePerLine
AllowAllArgumentsOnNextLine: true
AllowAllParametersOfDeclarationOnNextLine: true
BreakAfterReturnType: None
PenaltyReturnTypeOnItsOwnLine: 10000
# (an operator ends the line: no `== 0) {` alone after a call broken over lines)
BreakBeforeBinaryOperators: None
BreakBeforeTernaryOperators: true
# (a condition too long for a line: one operand of && and || per line, as rustfmt does; a comparison or arithmetic
# stays together where it fits)
BreakBinaryOperations:
  Default: Never
  PerOperator:
    - Operators: ["&&", "||"]
      Style: OnePerLine
Cpp11BracedListStyle: true
SeparateDefinitionBlocks: Leave

# --- Pointers, spacing ----------------------------------------------------
DerivePointerAlignment: false
PointerAlignment: Left
ReferenceAlignment: Pointer
QualifierAlignment: Leave
SpaceAfterCStyleCast: false
SpaceBeforeAssignmentOperators: true
SpaceBeforeParens: ControlStatements
SpaceInEmptyBlock: false
SpacesBeforeTrailingComments: 1
SpacesInParens: Never
SpacesInSquareBrackets: false

# --- Things that must not change what MWCC compiles -----------------------
SortIncludes: Never
IncludeBlocks: Preserve
ReflowComments: false
BreakStringLiterals: false
RemoveParentheses: Leave
RemoveSemicolon: false
RemoveBracesLLVM: false
# (these stringify their condition into the assertion message: its spelling is the original's bytes)
WhitespaceSensitiveMacros: [OS_ASSERT, OPTION_ASSERT, IRO_ASSERT, IRO_ASSERT_T]
